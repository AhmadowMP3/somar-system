# --- server ---
PORT=8080
NODE_ENV=production
APP_BASE_URL=https://transport.example.com
TZ=Asia/Damascus

# --- Supabase (works with hosted or self-hosted) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STUDENT_EMAIL_DOMAIN=somar.local
SUPABASE_PHOTO_BUCKET=student-photos
SUPABASE_LOGO_BUCKET=university-logos

# --- frontend build-time (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api
VITE_APP_NAME=سومر تورز — النقل الجامعي
VITE_STUDENT_EMAIL_DOMAIN=somar.local

# --- web push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
VITE_VAPID_PUBLIC_KEY=

# --- bootstrap ---
BOOTSTRAP_ADMIN_CODE=ADMIN
BOOTSTRAP_ADMIN_PASSWORD=

# --- tooling only (tests, seed, migrations script); never needed by the running container ---
DATABASE_URL=
DISABLE_CRON=false
