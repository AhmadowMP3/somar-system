# ============================================================================
#  إعدادات الإنتاج — سومر تورز
#  انسخ هذا الملف إلى .env.production واملأه بيدك. لا تلصق أي قيمة سرية في الشات.
#  .env.production موجود في .gitignore ولن يُرفع إلى GitHub أبداً.
# ============================================================================

# --- الدومينات (ليست أسراراً) ---
# رابط بوابة Supabase (Kong) كما يراه المتصفح والخادم
SUPABASE_URL=https://somar-supa.ahmad-zaven.io
# رابط التطبيق
APP_BASE_URL=https://somar.ahmad-zaven.io

# --- مفاتيح Supabase ---
# مفتاح anon — في Coolify غالباً اسمه SERVICE_SUPABASEANON_KEY (عام، لكن انسخه بيدك)
SUPABASE_ANON_KEY=
# مفتاح service_role — في Coolify غالباً SERVICE_SUPABASESERVICE_KEY
# ⚠️ سري جداً: يعطي تحكماً كاملاً بقاعدة البيانات. لا تضعه أبداً في أي متغير يبدأ بـ VITE_
SUPABASE_SERVICE_ROLE_KEY=

# --- اتصال قاعدة البيانات (Postgres) ---
# المستخدم غالباً postgres
POSTGRES_USER=postgres
# ⚠️ سري: كلمة سر Postgres — في Coolify غالباً SERVICE_PASSWORD_POSTGRES
POSTGRES_PASSWORD=
# العنوان والمنفذ الذي يصل إليه جهازك (إن كانت القاعدة منشورة للخارج: IP الخادم ومنفذها العام)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres
# اتركه فارغاً: يُبنى تلقائياً من القيم أعلاه (مع ترميز الرموز الخاصة في كلمة السر)
DATABASE_URL=

# --- قيم الواجهة (تُملأ تلقائياً من القيم أعلاه، لا تغيّرها) ---
VITE_SUPABASE_URL=https://somar-supa.ahmad-zaven.io
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api
VITE_APP_NAME=سومر تورز — النقل الجامعي
VITE_STUDENT_EMAIL_DOMAIN=somar.local
SUPABASE_STUDENT_EMAIL_DOMAIN=somar.local

# --- التخزين ---
SUPABASE_PHOTO_BUCKET=student-photos
SUPABASE_LOGO_BUCKET=university-logos

# --- الخادم ---
PORT=8080
NODE_ENV=production
TZ=Asia/Damascus

# --- الإشعارات (تُولّد في المرحلة 8) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ahmad-zaven.io
VITE_VAPID_PUBLIC_KEY=

# --- المدير الأول (المرحلة 10) ---
BOOTSTRAP_ADMIN_CODE=ADMIN
BOOTSTRAP_ADMIN_PASSWORD=
